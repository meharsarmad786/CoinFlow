<div class="container mx-auto px-4 py-8 max-w-4xl">
  <h1 class="text-4xl font-bold text-white mb-8">Price Alerts</h1>

  <!-- Create Alert Form -->
  <div class="bg-slate-800/50 backdrop-blur-sm border border-purple-500/20 rounded-lg p-6 mb-8">
    <h2 class="text-2xl font-bold text-white mb-4">Create New Alert</h2>
    <%= form_with model: [PriceAlert.new], url: price_alerts_path, local: true do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div>
          <%= f.label :cryptocurrency_id, "Cryptocurrency", class: "block text-gray-300 mb-2" %>
          <%= f.collection_select :cryptocurrency_id, Cryptocurrency.order(:symbol), :id, :symbol, 
              { selected: params[:crypto_id], prompt: "Select crypto" },
              { class: "w-full px-4 py-2 bg-slate-900 border border-purple-500/30 rounded-lg text-white focus:outline-none focus:border-purple-500", required: true } %>
        </div>
        <div>
          <%= f.label :target_price, "Target Price (USD)", class: "block text-gray-300 mb-2" %>
          <%= f.number_field :target_price, step: 0.01, class: "w-full px-4 py-2 bg-slate-900 border border-purple-500/30 rounded-lg text-white focus:outline-none focus:border-purple-500", required: true %>
        </div>
        <div>
          <%= f.label :alert_type, "Alert When", class: "block text-gray-300 mb-2" %>
          <%= f.select :alert_type, 
              options_for_select([['Price goes above', 'above'], ['Price goes below', 'below']]),
              {},
              { class: "w-full px-4 py-2 bg-slate-900 border border-purple-500/30 rounded-lg text-white focus:outline-none focus:border-purple-500" } %>
        </div>
        <div class="flex items-end">
          <%= f.submit "Create Alert", class: "w-full px-4 py-2 bg-purple-600 hover:bg-purple-700 rounded-lg font-semibold transition" %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Active Alerts -->
  <div class="bg-slate-800/50 backdrop-blur-sm border border-purple-500/20 rounded-lg p-6 mb-6">
    <h2 class="text-2xl font-bold text-white mb-4">Active Alerts</h2>
    <% if @active_alerts.any? %>
      <div class="space-y-3">
        <% @active_alerts.each do |alert| %>
          <div class="flex items-center justify-between p-4 bg-slate-900/50 rounded-lg">
            <div>
              <p class="font-bold text-white"><%= alert.cryptocurrency.symbol %></p>
              <p class="text-sm text-gray-400">
                Alert when price <%= alert.alert_type == 'above' ? 'goes above' : 'goes below' %> 
                $<%= number_with_delimiter(alert.target_price.round(2)) %>
              </p>
              <p class="text-xs text-gray-500 mt-1">Current: $<%= alert.cryptocurrency.formatted_price %></p>
            </div>
            <%= link_to "Delete", price_alert_path(alert), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "px-4 py-2 bg-red-600 hover:bg-red-700 rounded-lg transition" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-400 text-center py-8">No active alerts. Create one above!</p>
    <% end %>
  </div>

  <!-- Triggered Alerts -->
  <% if @triggered_alerts.any? %>
    <div class="bg-slate-800/50 backdrop-blur-sm border border-purple-500/20 rounded-lg p-6">
      <h2 class="text-2xl font-bold text-white mb-4">Triggered Alerts</h2>
      <div class="space-y-3">
        <% @triggered_alerts.each do |alert| %>
          <div class="flex items-center justify-between p-4 bg-green-500/10 border border-green-500/30 rounded-lg">
            <div>
              <p class="font-bold text-white"><%= alert.cryptocurrency.symbol %></p>
              <p class="text-sm text-gray-400">
                Alert triggered! Price <%= alert.alert_type == 'above' ? 'went above' : 'went below' %> 
                $<%= number_with_delimiter(alert.target_price.round(2)) %>
              </p>
              <p class="text-xs text-gray-500 mt-1">Triggered: <%= alert.updated_at.strftime('%b %d, %Y %I:%M %p') %></p>
            </div>
            <%= link_to "Delete", price_alert_path(alert), data: { turbo_method: :delete }, class: "px-4 py-2 bg-red-600 hover:bg-red-700 rounded-lg transition" %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
