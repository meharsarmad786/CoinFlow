<% if controller_name != 'sessions' %>
  <%= link_to "Sign in", new_session_path(resource_name), class: "text-purple-400 hover:text-purple-300 transition" %><br />
<% end %>

<% if devise_mapping.registerable? && controller_name != 'registrations' %>
  <%= link_to "Sign up", new_registration_path(resource_name), class: "text-purple-400 hover:text-purple-300 transition" %><br />
<% end %>

<% if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
  <%= link_to "Forgot your password?", new_password_path(resource_name), class: "text-purple-400 hover:text-purple-300 transition" %><br />
<% end %>
