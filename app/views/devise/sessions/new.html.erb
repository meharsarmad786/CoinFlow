<div class="min-h-screen flex items-center justify-center px-4">
  <div class="max-w-md w-full">
    <div class="text-center mb-8">
      <h1 class="text-5xl font-bold mb-4 bg-gradient-to-r from-purple-400 via-pink-400 to-purple-400 bg-clip-text text-transparent">
        CoinFlow
      </h1>
      <h2 class="text-2xl text-white mb-2">Welcome Back</h2>
      <p class="text-gray-400">Sign in to your account</p>
    </div>

    <div class="bg-slate-800/50 backdrop-blur-sm border border-purple-500/20 rounded-lg p-8">
      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <% if alert %>
          <div class="mb-4 p-4 bg-red-500/20 border border-red-500/50 rounded-lg text-red-300">
            <%= alert %>
          </div>
        <% end %>

        <div class="space-y-6">
          <div>
            <%= f.label :email, class: "block text-gray-300 mb-2" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full px-4 py-3 bg-slate-900 border border-purple-500/30 rounded-lg text-white focus:outline-none focus:border-purple-500" %>
          </div>

          <div>
            <%= f.label :password, class: "block text-gray-300 mb-2" %>
            <%= f.password_field :password, autocomplete: "current-password", class: "w-full px-4 py-3 bg-slate-900 border border-purple-500/30 rounded-lg text-white focus:outline-none focus:border-purple-500" %>
          </div>

          <% if devise_mapping.rememberable? %>
            <div class="flex items-center">
              <%= f.check_box :remember_me, class: "mr-2" %>
              <%= f.label :remember_me, class: "text-gray-300" %>
            </div>
          <% end %>

          <div>
            <%= f.submit "Sign In", class: "w-full px-6 py-3 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 rounded-lg text-white font-semibold transition shadow-lg" %>
          </div>
        </div>
      <% end %>

      <div class="mt-6 text-center">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
