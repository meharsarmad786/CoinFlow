<div class="container mx-auto px-4 py-8 max-w-2xl">
  <h1 class="text-4xl font-bold text-white mb-8">New Transaction</h1>

  <div class="bg-slate-800/50 backdrop-blur-sm border border-purple-500/20 rounded-lg p-8">
    <%= form_with model: @transaction, local: true do |f| %>
      <% if @transaction.errors.any? %>
        <div class="mb-6 p-4 bg-red-500/20 border border-red-500/50 rounded-lg">
          <ul class="text-red-300">
            <% @transaction.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="space-y-6">
        <div>
          <%= f.label :cryptocurrency_id, "Cryptocurrency", class: "block text-gray-300 mb-2" %>
          <%= f.collection_select :cryptocurrency_id, Cryptocurrency.order(:symbol), :id, :symbol, 
              { selected: @cryptocurrency&.id, prompt: "Select cryptocurrency" },
              { class: "w-full px-4 py-2 bg-slate-900 border border-purple-500/30 rounded-lg text-white focus:outline-none focus:border-purple-500" } %>
        </div>

        <div>
          <%= f.label :transaction_type, "Type", class: "block text-gray-300 mb-2" %>
          <%= f.select :transaction_type, 
              options_for_select([['Buy', 'buy'], ['Sell', 'sell']], params[:type] || @transaction.transaction_type),
              {},
              { class: "w-full px-4 py-2 bg-slate-900 border border-purple-500/30 rounded-lg text-white focus:outline-none focus:border-purple-500" } %>
        </div>

        <div>
          <%= f.label :quantity, "Quantity", class: "block text-gray-300 mb-2" %>
          <%= f.number_field :quantity, step: 0.00000001, class: "w-full px-4 py-2 bg-slate-900 border border-purple-500/30 rounded-lg text-white focus:outline-none focus:border-purple-500", required: true %>
        </div>

        <div>
          <%= f.label :price, "Price per Coin (USD)", class: "block text-gray-300 mb-2" %>
          <%= f.number_field :price, step: 0.01, class: "w-full px-4 py-2 bg-slate-900 border border-purple-500/30 rounded-lg text-white focus:outline-none focus:border-purple-500", required: true, value: @cryptocurrency&.current_price %>
        </div>

        <div>
          <%= f.label :total_amount, "Total Amount (USD)", class: "block text-gray-300 mb-2" %>
          <%= f.number_field :total_amount, step: 0.01, class: "w-full px-4 py-2 bg-slate-900 border border-purple-500/30 rounded-lg text-white focus:outline-none focus:border-purple-500", required: true %>
          <p class="text-sm text-gray-400 mt-1">Auto-calculated: quantity × price</p>
        </div>

        <div class="flex gap-4">
          <%= f.submit "Create Transaction", class: "flex-1 px-6 py-3 bg-purple-600 hover:bg-purple-700 rounded-lg font-semibold transition" %>
          <%= link_to "Cancel", transactions_path, class: "px-6 py-3 bg-slate-700 hover:bg-slate-600 rounded-lg transition" %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const quantityField = document.querySelector('#transaction_quantity');
    const priceField = document.querySelector('#transaction_price');
    const totalField = document.querySelector('#transaction_total_amount');

    function calculateTotal() {
      if (quantityField && priceField && totalField) {
        const quantity = parseFloat(quantityField.value) || 0;
        const price = parseFloat(priceField.value) || 0;
        totalField.value = (quantity * price).toFixed(2);
      }
    }

    if (quantityField) quantityField.addEventListener('input', calculateTotal);
    if (priceField) priceField.addEventListener('input', calculateTotal);
  });
</script>

