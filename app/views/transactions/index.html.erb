<div class="container mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-4xl font-bold text-white">Transaction History</h1>
    <%= link_to "New Transaction", new_transaction_path, class: "px-6 py-3 bg-purple-600 hover:bg-purple-700 rounded-lg font-semibold transition" %>
  </div>

  <div class="mb-6 flex gap-2">
    <%= link_to "All", transactions_path, class: "px-4 py-2 #{params[:filter].blank? ? 'bg-purple-600' : 'bg-slate-700'} rounded-lg transition" %>
    <%= link_to "Buys", transactions_path(filter: 'buy'), class: "px-4 py-2 #{params[:filter] == 'buy' ? 'bg-green-600' : 'bg-slate-700'} rounded-lg transition" %>
    <%= link_to "Sells", transactions_path(filter: 'sell'), class: "px-4 py-2 #{params[:filter] == 'sell' ? 'bg-red-600' : 'bg-slate-700'} rounded-lg transition" %>
  </div>

  <div class="bg-slate-800/50 backdrop-blur-sm border border-purple-500/20 rounded-lg overflow-hidden">
    <table class="w-full">
      <thead class="bg-slate-900/50">
        <tr>
          <th class="px-6 py-4 text-left text-gray-400 font-semibold">Date</th>
          <th class="px-6 py-4 text-left text-gray-400 font-semibold">Type</th>
          <th class="px-6 py-4 text-left text-gray-400 font-semibold">Cryptocurrency</th>
          <th class="px-6 py-4 text-right text-gray-400 font-semibold">Quantity</th>
          <th class="px-6 py-4 text-right text-gray-400 font-semibold">Price</th>
          <th class="px-6 py-4 text-right text-gray-400 font-semibold">Total</th>
        </tr>
      </thead>
      <tbody>
        <% if @transactions.any? %>
          <% @transactions.each do |transaction| %>
            <tr class="border-t border-purple-500/10 hover:bg-slate-900/50 transition">
              <td class="px-6 py-4 text-gray-300"><%= transaction.created_at.strftime('%b %d, %Y') %></td>
              <td class="px-6 py-4">
                <span class="px-3 py-1 rounded-full text-sm font-semibold <%= transaction.transaction_type == 'buy' ? 'bg-green-500/20 text-green-400' : 'bg-red-500/20 text-red-400' %>">
                  <%= transaction.transaction_type.upcase %>
                </span>
              </td>
              <td class="px-6 py-4 text-white font-semibold"><%= transaction.cryptocurrency.symbol %></td>
              <td class="px-6 py-4 text-right text-gray-300"><%= transaction.quantity.round(8) %></td>
              <td class="px-6 py-4 text-right text-gray-300">$<%= number_with_delimiter(transaction.price.round(2)) %></td>
              <td class="px-6 py-4 text-right font-semibold <%= transaction.transaction_type == 'buy' ? 'text-green-400' : 'text-red-400' %>">
                <%= transaction.transaction_type == 'buy' ? '+' : '-' %>$<%= number_with_delimiter(transaction.total_amount.round(2)) %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="6" class="px-6 py-12 text-center text-gray-400">
              No transactions yet. <%= link_to "Create your first transaction", new_transaction_path, class: "text-purple-400 hover:text-purple-300" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-6 flex justify-center">
    <%= paginate @transactions %>
  </div>
</div>
