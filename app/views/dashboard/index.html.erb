<div class="container mx-auto px-4 py-8">
  <h1 class="text-4xl font-bold text-white mb-8">Dashboard</h1>

  <!-- Portfolio Summary -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="bg-gradient-to-br from-purple-600/20 to-pink-600/20 border border-purple-500/30 rounded-lg p-6 backdrop-blur-sm">
      <p class="text-gray-400 mb-2">Total Portfolio Value</p>
      <p class="text-3xl font-bold text-white">$<%= number_with_delimiter(@portfolio.total_value.round(2)) %></p>
    </div>
    <div class="bg-gradient-to-br from-green-600/20 to-emerald-600/20 border border-green-500/30 rounded-lg p-6 backdrop-blur-sm">
      <p class="text-gray-400 mb-2">Total Invested</p>
      <p class="text-3xl font-bold text-white">$<%= number_with_delimiter(@portfolio.total_invested.round(2)) %></p>
    </div>
    <div class="bg-gradient-to-br <%= @portfolio.total_profit_loss >= 0 ? 'from-green-600/20 to-emerald-600/20 border-green-500/30' : 'from-red-600/20 to-rose-600/20 border-red-500/30' %> rounded-lg p-6 backdrop-blur-sm border">
      <p class="text-gray-400 mb-2">Profit/Loss</p>
      <p class="text-3xl font-bold text-white">
        <%= @portfolio.total_profit_loss >= 0 ? '+' : '' %>$<%= number_with_delimiter(@portfolio.total_profit_loss.round(2)) %>
        <span class="text-lg">(<%= @portfolio.profit_loss_percentage %>%%)</span>
      </p>
    </div>
  </div>

  <!-- Charts Section -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
    <!-- Portfolio Distribution Chart -->
    <% if @portfolio_items.any? && @portfolio_chart_labels.present? %>
      <div class="bg-slate-800/50 backdrop-blur-sm border border-purple-500/20 rounded-lg p-6">
        <h2 class="text-2xl font-bold text-white mb-4">Portfolio Distribution</h2>
        <div class="relative h-80">
          <canvas id="portfolioChart"></canvas>
        </div>
      </div>
    <% end %>

    <!-- Portfolio Performance Chart -->
    <% if @performance_dates.present? %>
      <div class="bg-slate-800/50 backdrop-blur-sm border border-purple-500/20 rounded-lg p-6">
        <h2 class="text-2xl font-bold text-white mb-4">Portfolio Performance (30 Days)</h2>
        <div class="relative h-80">
          <canvas id="performanceChart"></canvas>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Holdings Performance Chart -->
  <% if @portfolio_items.any? %>
    <div class="bg-slate-800/50 backdrop-blur-sm border border-purple-500/20 rounded-lg p-6 mb-8">
      <h2 class="text-2xl font-bold text-white mb-4">Holdings Performance</h2>
      <div class="relative h-96">
        <canvas id="holdingsChart"></canvas>
      </div>
    </div>
  <% end %>

  <!-- Market Trends Chart -->
  <% if @market_trends_labels.present? %>
    <div class="bg-slate-800/50 backdrop-blur-sm border border-purple-500/20 rounded-lg p-6 mb-8">
      <h2 class="text-2xl font-bold text-white mb-4">Top 10 Cryptocurrencies - 24h Change</h2>
      <div class="relative h-96">
        <canvas id="marketTrendsChart"></canvas>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Portfolio Holdings -->
    <div class="bg-slate-800/50 backdrop-blur-sm border border-purple-500/20 rounded-lg p-6">
      <h2 class="text-2xl font-bold text-white mb-4">Your Holdings</h2>
      <% if @portfolio_items.any? %>
        <div class="space-y-4">
          <% @portfolio_items.each do |item| %>
            <div class="flex items-center justify-between p-4 bg-slate-900/50 rounded-lg">
              <div>
                <p class="font-bold text-white"><%= item.cryptocurrency.symbol %></p>
                <p class="text-sm text-gray-400"><%= item.quantity.round(8) %> <%= item.cryptocurrency.symbol %></p>
              </div>
              <div class="text-right">
                <p class="font-semibold text-white">$<%= number_with_delimiter(item.current_value.round(2)) %></p>
                <p class="text-sm <%= item.profit_loss >= 0 ? 'text-green-400' : 'text-red-400' %>">
                  <%= item.profit_loss >= 0 ? '+' : '' %>$<%= number_with_delimiter(item.profit_loss.round(2)) %>
                  (<%= item.profit_loss_percentage %>%)
                </p>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-400 text-center py-8">No holdings yet. Start by adding a transaction!</p>
        <%= link_to "Add Transaction", new_transaction_path, class: "block text-center px-4 py-2 bg-purple-600 hover:bg-purple-700 rounded-lg transition" %>
      <% end %>
    </div>

    <!-- Recent Transactions -->
    <div class="bg-slate-800/50 backdrop-blur-sm border border-purple-500/20 rounded-lg p-6">
      <h2 class="text-2xl font-bold text-white mb-4">Recent Transactions</h2>
      <% if @recent_transactions.any? %>
        <div class="space-y-3">
          <% @recent_transactions.each do |transaction| %>
            <div class="flex items-center justify-between p-3 bg-slate-900/50 rounded-lg">
              <div>
                <p class="font-semibold text-white">
                  <%= transaction.transaction_type.capitalize %> <%= transaction.cryptocurrency.symbol %>
                </p>
                <p class="text-sm text-gray-400"><%= transaction.created_at.strftime('%b %d, %Y %I:%M %p') %></p>
              </div>
              <div class="text-right">
                <p class="font-semibold <%= transaction.transaction_type == 'buy' ? 'text-green-400' : 'text-red-400' %>">
                  <%= transaction.transaction_type == 'buy' ? '+' : '-' %>$<%= number_with_delimiter(transaction.total_amount.round(2)) %>
                </p>
                <p class="text-sm text-gray-400"><%= transaction.quantity.round(8) %> @ $<%= transaction.price.round(2) %></p>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-400 text-center py-8">No transactions yet.</p>
      <% end %>
    </div>
  </div>

  <!-- Top Cryptocurrencies -->
  <div class="mt-8 bg-slate-800/50 backdrop-blur-sm border border-purple-500/20 rounded-lg p-6">
    <h2 class="text-2xl font-bold text-white mb-4">Market Overview</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
        <% @top_cryptos.each do |crypto| %>
          <%= link_to cryptocurrency_path(crypto), class: "block bg-slate-900/50 rounded-lg p-4 hover:bg-slate-900 transition" do %>
          <div class="flex items-center justify-between mb-2">
            <span class="font-bold text-white"><%= crypto.symbol %></span>
            <span class="text-sm <%= crypto.price_change_color %>">
              <%= crypto.price_change_percentage_24h&.positive? ? '+' : '' %><%= crypto.price_change_percentage_24h&.round(2) %>%
            </span>
          </div>
          <p class="text-gray-400 text-sm mb-2"><%= crypto.name %></p>
          <p class="text-lg font-semibold text-white"><%= crypto.formatted_price %></p>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<script>
  // Chart.js configuration
  Chart.defaults.color = '#9CA3AF';
  Chart.defaults.borderColor = 'rgba(139, 92, 246, 0.2)';
  Chart.defaults.backgroundColor = 'rgba(139, 92, 246, 0.1)';

  // Portfolio Distribution Chart (Doughnut)
  <% if @portfolio_items.any? && @portfolio_chart_labels.present? %>
    const portfolioCtx = document.getElementById('portfolioChart');
    if (portfolioCtx) {
      new Chart(portfolioCtx, {
        type: 'doughnut',
        data: {
          labels: <%= raw @portfolio_chart_labels.to_json %>,
          datasets: [{
            data: <%= raw @portfolio_chart_values.to_json %>,
            backgroundColor: <%= raw @portfolio_chart_colors.to_json %>,
            borderWidth: 2,
            borderColor: '#1e293b'
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: 'bottom',
              labels: {
                color: '#E5E7EB',
                padding: 15,
                font: {
                  size: 12
                }
              }
            },
            tooltip: {
              callbacks: {
                label: function(context) {
                  let label = context.label || '';
                  let value = context.parsed || 0;
                  let total = context.dataset.data.reduce((a, b) => a + b, 0);
                  let percentage = ((value / total) * 100).toFixed(1);
                  return label + ': $' + value.toLocaleString() + ' (' + percentage + '%)';
                }
              }
            }
          }
        }
      });
    }
  <% end %>

  // Portfolio Performance Chart (Line)
  <% if @performance_dates.present? %>
    const performanceCtx = document.getElementById('performanceChart');
    if (performanceCtx) {
      new Chart(performanceCtx, {
        type: 'line',
        data: {
          labels: <%= raw @performance_dates.to_json %>,
          datasets: [
            {
              label: 'Portfolio Value',
              data: <%= raw @performance_values.to_json %>,
              borderColor: 'rgba(139, 92, 246, 1)',
              backgroundColor: 'rgba(139, 92, 246, 0.1)',
              borderWidth: 3,
              fill: true,
              tension: 0.4,
              pointRadius: 4,
              pointHoverRadius: 6
            },
            {
              label: 'Profit/Loss',
              data: <%= raw @performance_profits.to_json %>,
              borderColor: 'rgba(34, 197, 94, 1)',
              backgroundColor: 'rgba(34, 197, 94, 0.1)',
              borderWidth: 2,
              fill: true,
              tension: 0.4,
              pointRadius: 3,
              pointHoverRadius: 5
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: 'top',
              labels: {
                color: '#E5E7EB',
                font: {
                  size: 12
                }
              }
            },
            tooltip: {
              mode: 'index',
              intersect: false,
              callbacks: {
                label: function(context) {
                  return context.dataset.label + ': $' + context.parsed.y.toLocaleString();
                }
              }
            }
          },
          scales: {
            y: {
              beginAtZero: false,
              ticks: {
                color: '#9CA3AF',
                callback: function(value) {
                  return '$' + value.toLocaleString();
                }
              },
              grid: {
                color: 'rgba(139, 92, 246, 0.1)'
              }
            },
            x: {
              ticks: {
                color: '#9CA3AF'
              },
              grid: {
                color: 'rgba(139, 92, 246, 0.1)'
              }
            }
          }
        }
      });
    }
  <% end %>

  // Holdings Performance Chart (Bar)
  <% if @portfolio_items.any? %>
    const holdingsCtx = document.getElementById('holdingsChart');
    if (holdingsCtx) {
      const holdingsLabels = <%= raw @portfolio_items.map { |i| i.cryptocurrency.symbol }.to_json %>;
      const holdingsValues = <%= raw @portfolio_items.map { |i| i.current_value.round(2) }.to_json %>;
      const holdingsProfits = <%= raw @portfolio_items.map { |i| i.profit_loss.round(2) }.to_json %>;
      const holdingsColors = <%= raw @portfolio_items.map { |i| i.profit_loss >= 0 ? 'rgba(34, 197, 94, 0.8)' : 'rgba(239, 68, 68, 0.8)' }.to_json %>;

      new Chart(holdingsCtx, {
        type: 'bar',
        data: {
          labels: holdingsLabels,
          datasets: [
            {
              label: 'Current Value',
              data: holdingsValues,
              backgroundColor: 'rgba(139, 92, 246, 0.6)',
              borderColor: 'rgba(139, 92, 246, 1)',
              borderWidth: 2
            },
            {
              label: 'Profit/Loss',
              data: holdingsProfits,
              backgroundColor: holdingsColors,
              borderColor: holdingsColors,
              borderWidth: 2
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: 'top',
              labels: {
                color: '#E5E7EB',
                font: {
                  size: 12
                }
              }
            },
            tooltip: {
              callbacks: {
                label: function(context) {
                  return context.dataset.label + ': $' + context.parsed.y.toLocaleString();
                }
              }
            }
          },
          scales: {
            y: {
              beginAtZero: true,
              ticks: {
                color: '#9CA3AF',
                callback: function(value) {
                  return '$' + value.toLocaleString();
                }
              },
              grid: {
                color: 'rgba(139, 92, 246, 0.1)'
              }
            },
            x: {
              ticks: {
                color: '#9CA3AF'
              },
              grid: {
                color: 'rgba(139, 92, 246, 0.1)'
              }
            }
          }
        }
      });
    }
  <% end %>

  // Market Trends Chart (Line)
  <% if @market_trends_labels.present? %>
    const marketTrendsCtx = document.getElementById('marketTrendsChart');
    if (marketTrendsCtx) {
      new Chart(marketTrendsCtx, {
        type: 'line',
        data: {
          labels: <%= raw @market_trends_labels.to_json %>,
          datasets: [
            {
              label: '24h Change (%)',
              data: <%= raw @market_trends_changes.to_json %>,
              borderColor: function(context) {
                const value = context.parsed.y;
                return value >= 0 ? 'rgba(34, 197, 94, 1)' : 'rgba(239, 68, 68, 1)';
              },
              backgroundColor: function(context) {
                const value = context.parsed.y;
                return value >= 0 ? 'rgba(34, 197, 94, 0.1)' : 'rgba(239, 68, 68, 0.1)';
              },
              borderWidth: 3,
              fill: true,
              tension: 0.4,
              pointRadius: 5,
              pointHoverRadius: 7,
              pointBackgroundColor: function(context) {
                const value = context.parsed.y;
                return value >= 0 ? 'rgba(34, 197, 94, 1)' : 'rgba(239, 68, 68, 1)';
              }
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: 'top',
              labels: {
                color: '#E5E7EB',
                font: {
                  size: 12
                }
              }
            },
            tooltip: {
              callbacks: {
                label: function(context) {
                  const value = context.parsed.y;
                  const sign = value >= 0 ? '+' : '';
                  return context.dataset.label + ': ' + sign + value.toFixed(2) + '%';
                }
              }
            }
          },
          scales: {
            y: {
              beginAtZero: false,
              ticks: {
                color: '#9CA3AF',
                callback: function(value) {
                  return value.toFixed(2) + '%';
                }
              },
              grid: {
                color: 'rgba(139, 92, 246, 0.1)'
              }
            },
            x: {
              ticks: {
                color: '#9CA3AF'
              },
              grid: {
                color: 'rgba(139, 92, 246, 0.1)'
              }
            }
          }
        }
      });
    }
  <% end %>
</script>
