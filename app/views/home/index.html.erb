<div class="min-h-screen">
  <!-- Hero Section -->
  <div class="text-center py-20 px-4">
    <h1 class="text-6xl md:text-8xl font-bold mb-6 bg-gradient-to-r from-purple-400 via-pink-400 to-purple-400 bg-clip-text text-transparent">
      CoinFlow
    </h1>
    <p class="text-2xl md:text-3xl text-gray-300 mb-8">
      Your Gateway to the Crypto Universe
    </p>
    <p class="text-lg text-gray-400 max-w-2xl mx-auto mb-12">
      Track prices, manage your portfolio, set alerts, and stay ahead in the cryptocurrency market. 
      Built for billions, designed for you.
    </p>
    <div class="flex justify-center space-x-4">
      <% if user_signed_in? %>
        <%= link_to "Go to Dashboard", dashboard_path, class: "px-8 py-4 bg-gradient-to-r from-purple-600 to-pink-600 rounded-lg text-white font-semibold hover:from-purple-700 hover:to-pink-700 transition shadow-lg" %>
      <% else %>
        <%= link_to "Get Started", new_user_registration_path, class: "px-8 py-4 bg-gradient-to-r from-purple-600 to-pink-600 rounded-lg text-white font-semibold hover:from-purple-700 hover:to-pink-700 transition shadow-lg" %>
        <%= link_to "Sign In", new_user_session_path, class: "px-8 py-4 bg-slate-800 border border-purple-500/50 rounded-lg text-white font-semibold hover:bg-slate-700 transition" %>
      <% end %>
    </div>
  </div>

  <!-- Top Cryptocurrencies -->
  <% if @top_cryptos.any? %>
    <div class="container mx-auto px-4 py-12">
      <h2 class="text-3xl font-bold text-white mb-8 text-center">Top Cryptocurrencies</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
        <% @top_cryptos.each do |crypto| %>
          <div class="bg-slate-800/50 backdrop-blur-sm border border-purple-500/20 rounded-lg p-4 hover:border-purple-500/50 transition">
            <div class="flex items-center justify-between mb-2">
              <span class="font-bold text-white"><%= crypto.symbol %></span>
              <span class="text-sm <%= crypto.price_change_color %>">
                <%= crypto.price_change_percentage_24h&.positive? ? '+' : '' %><%= crypto.price_change_percentage_24h&.round(2) %>%
              </span>
            </div>
            <p class="text-gray-400 text-sm mb-2"><%= crypto.name %></p>
            <p class="text-xl font-semibold text-white"><%= crypto.formatted_price %></p>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Features Section -->
  <div class="container mx-auto px-4 py-20">
    <h2 class="text-4xl font-bold text-white mb-12 text-center">Why Choose CoinFlow?</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="bg-slate-800/50 backdrop-blur-sm border border-purple-500/20 rounded-lg p-6">
        <div class="text-4xl mb-4">📊</div>
        <h3 class="text-xl font-bold text-white mb-2">Real-Time Tracking</h3>
        <p class="text-gray-400">Monitor cryptocurrency prices in real-time with live updates and market data.</p>
      </div>
      <div class="bg-slate-800/50 backdrop-blur-sm border border-purple-500/20 rounded-lg p-6">
        <div class="text-4xl mb-4">💼</div>
        <h3 class="text-xl font-bold text-white mb-2">Portfolio Management</h3>
        <p class="text-gray-400">Track your investments, calculate profits, and manage your crypto portfolio effortlessly.</p>
      </div>
      <div class="bg-slate-800/50 backdrop-blur-sm border border-purple-500/20 rounded-lg p-6">
        <div class="text-4xl mb-4">🔔</div>
        <h3 class="text-xl font-bold text-white mb-2">Price Alerts</h3>
        <p class="text-gray-400">Set custom price alerts and never miss important market movements.</p>
      </div>
    </div>
  </div>
</div>
