<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Coin Flow" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 min-h-screen">
    <% if user_signed_in? %>
      <nav class="fixed top-0 left-0 right-0 bg-slate-900/80 backdrop-blur-lg border-b border-purple-500/20 z-50">
        <div class="container mx-auto px-4">
          <div class="flex items-center justify-between h-16">
            <div class="flex items-center space-x-8">
              <%= link_to "CoinFlow", dashboard_path, class: "text-2xl font-bold bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent" %>
              <%= link_to "Dashboard", dashboard_path, class: "text-gray-300 hover:text-purple-400 transition" %>
              <%= link_to "Markets", cryptocurrencies_path, class: "text-gray-300 hover:text-purple-400 transition" %>
              <%= link_to "Portfolio", portfolios_path, class: "text-gray-300 hover:text-purple-400 transition" %>
              <%= link_to "Transactions", transactions_path, class: "text-gray-300 hover:text-purple-400 transition" %>
              <%= link_to "Alerts", price_alerts_path, class: "text-gray-300 hover:text-purple-400 transition" %>
            </div>
            <div class="flex items-center space-x-4">
              <span class="text-gray-400"><%= current_user.email %></span>
              <%= link_to "Sign Out", destroy_user_session_path, data: { turbo_method: :delete }, class: "px-4 py-2 bg-purple-600 hover:bg-purple-700 rounded-lg transition" %>
            </div>
          </div>
        </div>
      </nav>
    <% end %>

    <% if notice %>
      <div class="fixed top-20 right-4 bg-green-500 text-white px-6 py-3 rounded-lg shadow-lg z-50">
        <%= notice %>
      </div>
    <% end %>

    <% if alert %>
      <div class="fixed top-20 right-4 bg-red-500 text-white px-6 py-3 rounded-lg shadow-lg z-50">
        <%= alert %>
      </div>
    <% end %>

    <main class="<%= user_signed_in? ? 'mt-20' : '' %>">
      <%= yield %>
    </main>
  </body>
</html>
